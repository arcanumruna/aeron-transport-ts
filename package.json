{
  "name": "aeron-transport-ts",
  "version": "0.0.0",
  "description": "TypeScript port of the Aeron UDP transport for Node.js",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arcanumruna/aeron-transport-ts.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "fetch:refs": "sh scripts/fetch-refs.sh",
    "check:mapping": "node scripts/check-test-mapping.mjs",
    "bench:micro": "node --expose-gc --experimental-transform-types --import ./test/support/workerRegister.mjs --no-warnings bench/lib/runMicro.ts",
    "bench:gate": "node --experimental-transform-types --import ./test/support/workerRegister.mjs --no-warnings bench/lib/gate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
